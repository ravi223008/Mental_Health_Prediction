#!/usr/bin/env python3
import logging
from pathlib import Path
import numpy as np
import pandas as pd
import joblib

from sklearn.isotonic import IsotonicRegression
from sklearn.metrics import f1_score, roc_auc_score, confusion_matrix, classification_report

logging.basicConfig(level=logging.INFO, format="%(asctime)s - %(levelname)s - %(message)s")
logger = logging.getLogger("threshold_eval_reweight")

# ---------- data loading (matches your pipeline) ----------
def load_and_split_data(base_dir: str = "../data/processed"):
    data_path = Path(base_dir) / "clean_numeric.csv"
    splits_path = Path(base_dir) / "splits_70_15_15_k5.csv"
    df = pd.read_csv(data_path).reset_index().rename(columns={"index": "row_id"})
    splits = pd.read_csv(splits_path)
    df = df.merge(splits, on="row_id", how="left")
    train_df = df[df["split"] == "train"].copy()
    val_df = df[df["split"] == "val"].copy()
    test_df = df[df["split"] == "test"].copy()

    drop_cols = [c for c in ["User_ID", "Severity_ord", "split", "cv_fold"] if c in train_df.columns]
    X_train = train_df.drop(columns=drop_cols)
    y_train = train_df["Severity_ord"].astype(int)
    X_val = val_df.drop(columns=drop_cols)
    y_val = val_df["Severity_ord"].astype(int)
    X_test = test_df.drop(columns=drop_cols)
    y_test = test_df["Severity_ord"].astype(int)
    return X_train, y_train, X_val, y_val, X_test, y_test

def multiclass_brier_score(y_true: np.ndarray, probas: np.ndarray) -> float:
    onehot = np.zeros_like(probas)
    onehot[np.arange(len(y_true)), y_true] = 1
    return float(np.mean(np.sum((probas - onehot) ** 2, axis=1)))

def normalize_rows(arr: np.ndarray) -> np.ndarray:
    s = arr.sum(axis=1, keepdims=True)
    s[s == 0.0] = 1.0
    return arr / s

def main():
    out_dir = Path("outputs_lightgbm")
    model_path = out_dir / "lgbm_final.pkl"
    if not model_path.exists():
        raise FileNotFoundError(f"Model not found at {model_path}")

    # Load data/model
    X_train, y_train, X_val, y_val, X_test, y_test = load_and_split_data()
    feats = [c for c in X_train.columns if c != "row_id"]
    model = joblib.load(model_path)

    # Raw probs
    p_val_raw = model.predict_proba(X_val[feats])
    p_test_raw = model.predict_proba(X_test[feats])

    # ---- Per-class isotonic calibration on validation ----
    ir = [IsotonicRegression(out_of_bounds="clip") for _ in range(p_val_raw.shape[1])]
    p_val_cal_cols, p_test_cal_cols = [], []
    for c in range(p_val_raw.shape[1]):
        ir[c].fit(p_val_raw[:, c], (y_val.values == c).astype(int))
        p_val_cal_cols.append(ir[c].predict(p_val_raw[:, c]))
        p_test_cal_cols.append(ir[c].predict(p_test_raw[:, c]))
    p_val_cal = normalize_rows(np.column_stack(p_val_cal_cols))
    p_test_cal = normalize_rows(np.column_stack(p_test_cal_cols))

    # ---- Joint class reweighting on validation ----
    # We fix w_med = 1.0 and grid-search w_low, w_high.
    grid = np.linspace(0.5, 3.0, 26)  # [0.5, 3.0] step 0.1; widen if needed
    best = {"w_low": 1.0, "w_med": 1.0, "w_high": 1.0, "macro_f1": -1.0, "minority_weighted": -1.0}

    for wl in grid:
        for wh in grid:
            W = np.array([wl, 1.0, wh])[None, :]  # shape [1,3]
            pred = (p_val_cal * W).argmax(axis=1)
            f1_macro = f1_score(y_val, pred, average="macro")
            f1_per = f1_score(y_val, pred, average=None, labels=[0, 1, 2])  # [low, med, high]
            minority_weighted = (2.0*f1_per[0] + 1.0*f1_per[1] + 2.0*f1_per[2]) / 5.0

            # Primary key: standard macro-F1; tie-break with minority-weighted
            better = (f1_macro > best["macro_f1"]) or (np.isclose(f1_macro, best["macro_f1"]) and minority_weighted > best["minority_weighted"])
            if better:
                best = {"w_low": float(wl), "w_med": 1.0, "w_high": float(wh),
                        "macro_f1": float(f1_macro), "minority_weighted": float(minority_weighted)}

    logger.info(f"Best weights on val: w_low={best['w_low']:.2f}, w_med=1.00, w_high={best['w_high']:.2f} "
                f"(val macro_f1={best['macro_f1']:.4f}; minority_weighted={best['minority_weighted']:.4f})")

    # ---- Apply best weights to calibrated TEST probs ----
    Wbest = np.array([best["w_low"], 1.0, best["w_high"]])[None, :]
    pred_test = (p_test_cal * Wbest).argmax(axis=1)

    # Metrics on test
    macro_f1 = f1_score(y_test, pred_test, average="macro")
    macro_auc = roc_auc_score(pd.get_dummies(y_test).values, p_test_cal, multi_class="ovr", average="macro")
    brier = multiclass_brier_score(y_test.values, p_test_cal)
    cm = confusion_matrix(y_test, pred_test)
    report = classification_report(y_test, pred_test, target_names=["low","med","high"], output_dict=False)

    thr_dir = out_dir / "thresholded_reweight"
    thr_dir.mkdir(parents=True, exist_ok=True)
    pd.Series({"macro_f1": macro_f1, "macro_auc": macro_auc, "brier": brier}).to_csv(thr_dir / "metrics_thresholded_reweight.csv")
    np.save(thr_dir / "confusion_matrix_thresholded_reweight.npy", cm)
    with open(thr_dir / "classification_report_thresholded_reweight.txt", "w") as fh:
        fh.write(report)
    pd.Series({"low": best["w_low"], "med": 1.0, "high": best["w_high"]}).to_csv(thr_dir / "class_weights_reweight.csv")

    pred_counts = pd.Series(pred_test).value_counts().sort_index().to_dict()
    logger.info(f"[calibrated+reweighted] test macro_f1={macro_f1:.4f} macro_auc={macro_auc:.4f} brier={brier:.4f} pred_counts={pred_counts}")
    print(f"[threshold_eval_reweight] Saved outputs to: {thr_dir}")

if __name__ == "__main__":
    main()
